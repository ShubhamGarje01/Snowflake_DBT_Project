        WHEN RESPONSE_RATE > 65 AND  RESPONSE_RATE < 80 THEN 'FAIR'
        ELSE 'POOR'
    END AS RESPONSE_RATE_QUALITY,
    RESPONSE_RATE,
    CREATED_AT
from AIRBNB.bronze.bronze_hosts
    )

